# .env.testnet.example
#
# Copy this file to .env.testnet and fill in the values after deploying
# the contracts to Stellar testnet.
#
# Usage:
#   cp .env.testnet.example .env.testnet
#   # edit .env.testnet with your deployed contract IDs
#   source .env.testnet
#   ./scripts/smoke-test.sh
#
# IMPORTANT: Never commit .env.testnet — it is listed in .gitignore.

# ---------------------------------------------------------------------------
# Stellar identity & network
# ---------------------------------------------------------------------------
# The name of your funded testnet identity created via:
#   stellar keys generate --global deployer --network testnet --fund
STELLAR_IDENTITY=deployer
STELLAR_NETWORK=testnet

# ---------------------------------------------------------------------------
# Deployed contract addresses
# All values must start with 'C' and be 56 characters long (StrKey format).
# ---------------------------------------------------------------------------

# CHV utility token (contracts/chv_token)
CHV_TOKEN_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# On-chain course completion certificates (contracts/certificates)
CERTIFICATES_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Buyer-seller payment escrow with token transfer (contracts/escrow)
ESCROW_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Multisig vault requiring approver threshold (contracts/escrow-vault)
ESCROW_VAULT_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Core platform logic and access control (contracts/chainverse-core)
CHAINVERSE_CORE_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# On-chain reward distribution for learners (contracts/reward)
REWARD_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Course registry and enrollment records (contracts/course_registry)
COURSE_REGISTRY_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Automated instructor payout processing (contracts/payout-automation)
PAYOUT_AUTOMATION_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# CHV staking for rewards and gated content (contracts/staking)
STAKING_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
